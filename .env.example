# Provider: gemini | fake
# "fake" runs the whole pipeline offline with a deterministic stub client —
# no API key needed. Useful for reviewing this repo without provisioning keys.
LLM_PROVIDER=gemini

# Gemini — free tier is enough for this task.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# 0 = thinking off (default, cheapest). "auto" lets the model decide.
GEMINI_THINKING_BUDGET=0

# Pipeline tuning
MAX_CONCURRENCY=5
MAX_ATTEMPTS=3
REQUEST_TIMEOUT_S=60
